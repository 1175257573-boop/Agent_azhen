{
  "name": "atlas-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas 控制台桌面客户端：托管 Python 后端，并以独立窗口打开界面",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js --dev",
    "dist": "electron-builder --win --x64"
  },
  "author": "1175257573-boop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5"
  },
  "build": {
    "appId": "cn.atlas.desktop",
    "productName": "Atlas 控制台",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Atlas 控制台"
    }
  }
}
