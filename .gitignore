# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- IDE ----------
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath

# ---------- 本项目运行时产物 ----------
runs/
*.sqlite
*.sqlite-journal
checkpoints.sqlite

# ---------- 密钥：任何情况下都不入库 ----------
.env
.env.*
# 但样例文件必须入库（否则别人克隆下来不知道该配什么）
!.env.example
*.key
*.pem
*.p12
secrets/
credentials.json

# ---------- 凭据兜底（纵深防御）----------
# 对应 agent_kit/credentials.py 的落盘位置 ATLAS_HOME/credentials.json
# 以及「记住到本机」开关产生的文件。上面已有 credentials.json，
# 这里再覆盖「子目录 / 变体命名」两种情况，防止 .gitignore 规则被误改后裸奔。
.atlas/
**/credentials.json
*.credentials.json
*.local.env
*.secret

# ---------- 桌面客户端（Electron，见 desktop/）----------
# node_modules 约 380MB，且 Electron 二进制随平台不同，绝不能入库
desktop/node_modules/
desktop/dist/
desktop/out/

# ---------- 前端（web/，React + Vite）----------
# node_modules 与构建产物都不入库：先 npm install && npm run build 再跑后端
web/node_modules/
web/dist/
# Vite 加载 vite.config.ts 时产生的临时文件
web/vite.config.ts.timestamp-*.mjs
# 本机记住的解释器路径，因机器而异，不入库
desktop/.atlas-desktop.json

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
