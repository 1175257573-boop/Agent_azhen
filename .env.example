# ---------------------------------------------------------------------------
# Atlas · LangChain 1.4 Agent —— 环境变量样例
#
# 用法：复制成 .env 后按需填写（.env 已被 .gitignore 排除，不会入库）
#   cp .env.example .env          # Linux / macOS
#   copy .env.example .env        # Windows
#
# 优先级：系统环境变量 > 项目根目录 .env
# 也就是说 .env 里没写的项，仍会回落到系统环境变量；反之 .env 会覆盖同名系统变量吗？
# 不会 —— 本项目用 override=False 加载，系统环境变量优先，.env 只做兜底。
#
# ⚠️ 下面所有 Key 都留空，请填你自己的。不要把填好的 .env 提交到任何仓库。
# ---------------------------------------------------------------------------


# ===================== 1. 模型（必填其一） =====================
# 不配任何 Key 时程序会直接报错退出，不会静默降级成假模型。

# 阿里云百炼 / DashScope（推荐，国内直连）
DASHSCOPE_API_KEY=
# 自定义兼容 OpenAI 的网关地址，留空则用官方默认
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# DeepSeek（走 OpenAI 兼容协议）
# DEEPSEEK_API_KEY=

# 手动指定 provider，留空则按上面的 Key 自动探测（dashscope > openai > anthropic）
# 可选：dashscope | openai | anthropic
# LLM_PROVIDER=

# 手动指定模型名，留空则用该 provider 的默认模型
# LLM_MODEL=


# ===================== 2. 短期记忆（Redis） =====================
# 不配 REDIS_URL 时自动降级为进程内内存，重启即失，但不影响运行。
SHORT_TERM_BACKEND=memory
# SHORT_TERM_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# checkpoint 过期时间（分钟），默认 10080（7 天）
# REDIS_TTL_MINUTES=10080

# 短期记忆喂给模型的消息窗口大小，默认 20 条
# MEMORY_WINDOW=20


# ===================== 3. 长期记忆（PostgreSQL） =====================
# 不配 PG_DSN 时自动降级为进程内内存。
LONG_TERM_BACKEND=memory
# LONG_TERM_BACKEND=postgres
# PG_DSN=postgresql://atlas:atlas@localhost:5432/atlas
# 也认这两个别名：POSTGRES_URL / DATABASE_URL

# 连接超时（秒），默认 5
# PG_CONNECT_TIMEOUT=5

# 1 = 后端连不上直接报错；0（默认）= 打印告警并降级内存
# MEMORY_STRICT=0


# ===================== 4. 记忆落盘（sqlite 备选） =====================
# 把 SHORT_TERM_BACKEND / LONG_TERM_BACKEND 设为 sqlite 时生效
# 留空则落盘到项目根的 runs/ 目录（已被 .gitignore 忽略）
# SQLITE_PATH=runs/memory.sqlite


# ===================== 5. 服务与调试 =====================
# FastAPI 的监听地址/端口走命令行参数，不是环境变量：
#   python main.py web --host 0.0.0.0 --port 8080

# 默认会话线程号（不配则按进程自动生成）
# THREAD_ID=

# LangSmith 链路追踪（可选，需要 langsmith 账号）
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=atlas-agent


# ===================== 6. MCP（可选） =====================
# MCP 不走环境变量，也不走配置文件 —— 默认连接项目内置的
# agent_kit/mcp_server.py（6 个工具），以 stdio 子进程方式启动。
#
# 想接自己的 MCP Server：把你的 .py 脚本路径传给 MCPHub.connect([...])，
# 见 agent_kit/mcp_client.py。
#
# 快速试一下：python main.py chat --mcp
